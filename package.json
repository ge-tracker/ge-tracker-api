{
  "name": "@getracker/api",
  "version": "5.0.0-beta.21",
  "description": "Official GE-Tracker.com API client",
  "scripts": {
    "build": "yarn run clean && yarn run build:cjs && yarn run build:umd",
    "build:cjs": "microbundle --format cjs",
    "build:umd": "microbundle --format umd --name GeTracker --external none",
    "clean": "rm -rf types && rm -rf dist",
    "watch": "microbundle watch --format cjs",
    "prepublishOnly": "yarn run build",
    "prepare": "husky install"
  },
  "files": [
    "dist",
    "types"
  ],
  "source": "src/index.ts",
  "main": "dist/index.js",
  "unpkg": "dist/index.umd.js",
  "types": "types/index.d.ts",
  "repository": "https://github.com/ge-tracker/ge-tracker-api",
  "contributors": [
    {
      "name": "James Austen",
      "email": "james@ge-tracker.com",
      "url": "https://www.ge-tracker.com"
    },
    {
      "name": "Kyle Stevenson",
      "email": "kyle@kylestevenson.me",
      "url": "kylestevenson.me"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^0.21.1",
    "deepmerge": "^4.2.2",
    "luxon": "^2.3.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.10",
    "@types/jest": "^26.0.20",
    "@types/luxon": "^2.0.9",
    "husky": ">=6",
    "lint-staged": ">=10",
    "microbundle": "^0.14.2",
    "prettier": "^2.6.2",
    "tslib": "^2.1.0",
    "typescript": "^4.1.3"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  }
}
