{
  "name": "@getracker/api",
  "version": "6.1.1",
  "description": "Official GE-Tracker.com API client",
  "repository": "https://github.com/ge-tracker/ge-tracker-api",
  "license": "MIT",
  "author": {
    "name": "James Austen",
    "email": "james@ge-tracker.com",
    "url": "https://www.ge-tracker.com"
  },
  "scripts": {
    "test": "jest --passWithNoTests",
    "build": "yarn clean && tsup",
    "clean": "rm -rf dist types",
    "watch": "tsup src/index.ts --watch --dts",
    "np": "np --no-publish --no-tests --no-cleanup --no-release-draft --message 'Bump version to v%s'",
    "prepublishOnly": "yarn run build",
    "prepare": "husky install",
    "postversion": "lifecycle/postversion"
  },
  "files": [
    "dist",
    "types",
    "jest"
  ],
  "type": "commonjs",
  "source": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": "./types/index.d.ts",
    "./jest/jest-mock": "./jest/jest-mock.ts"
  },
  "types": "./types/index.d.ts",
  "dependencies": {
    "axios": "^1.2.3",
    "deepmerge": "^4.2.2",
    "luxon": "^3.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@tsconfig/node18": "^18.2.1",
    "@types/jest": "^29.2.4",
    "@types/luxon": "^3.1.0",
    "husky": ">=6",
    "jest": "^29.3.1",
    "lint-staged": ">=10",
    "np": "^7.6.2",
    "prettier": "^2.8.1",
    "tslib": "^2.4.1",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.{js,ts,css,md}": "prettier --write"
  },
  "contributors": [
    {
      "name": "James Austen",
      "email": "james@ge-tracker.com",
      "url": "https://www.ge-tracker.com"
    },
    {
      "name": "Kyle Stevenson",
      "email": "kyle@kylestevenson.me",
      "url": "kylestevenson.me"
    }
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
