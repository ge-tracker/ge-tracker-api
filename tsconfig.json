{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",

    "verbatimModuleSyntax": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jest"]
  }
}
