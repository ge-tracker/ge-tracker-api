{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "declarationMap": true,
    "declaration": true,
    "outDir": "lib",
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "pretty": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/**"]
}
